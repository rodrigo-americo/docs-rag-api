# .env.example
POSTGRES_USER=docsrag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docsrag

DATABASE_URL=postgresql+asyncpg://docsrag:changeme@localhost:5433/docsrag

EMBEDDING_PROVIDER=fake
CHAT_PROVIDER=fake
# Só obrigatória quando EMBEDDING_PROVIDER=openai ou CHAT_PROVIDER=openai —
# em modo fake pode ficar vazia.
OPENAI_API_KEY=
# LangSmith — opcional na semana 1, obrigatório na semana 2 pra ter trace_id
# Se LANGSMITH_TRACING=false, langchain pula o tracing sem reclamar.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docs-rag-api

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console  # 'console' (colorido pra dev) ou 'json' (parseável pra prod)

# Rate limiting — sem autenticação (projeto de portfólio), o limite é por IP.
# Protege /query e /documents/ingest, os dois endpoints que custam OpenAI.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_INGEST=10/minute

# Fila — "inline" processa o ingest no mesmo processo (sem Redis, bom pra
# dev/teste). "redis" enfileira de verdade, exige um worker rodando separado
# (ver docker-compose.yml) e REDIS_URL preenchida.
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0